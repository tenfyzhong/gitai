#!/usr/bin/env bash
# Development helper for manually testing this checkout against a Homebrew installation.
# This script is not part of the normal gitai installation or runtime workflow.

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PROJECT_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
FORMULA=gitai
COMMANDS=(aipr aitag ai-commit-msg gitai-agent gitai-common.sh)

usage() {
    cat <<EOF
Usage: $(basename "$0") <link|restore>

Development helper for manually testing the current checkout in place of the
Homebrew-installed gitai commands. It is not part of the normal installation.

Commands:
  link      Unlink the Homebrew gitai formula and link this checkout's commands.
  restore   Remove this checkout's command links and relink the Homebrew formula.
EOF
}

fail() {
    echo "Error: $1" >&2
    exit 1
}

is_project_link() {
    local target=$1
    local source=$2
    [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ]
}

check_sources() {
    local command
    for command in "${COMMANDS[@]}"; do
        [ -x "$PROJECT_ROOT/$command" ] || fail "Source command is not executable: $PROJECT_ROOT/$command"
    done
}

link_development_commands() {
    check_sources

    local all_linked=1
    local command
    for command in "${COMMANDS[@]}"; do
        if ! is_project_link "$BIN_DIR/$command" "$PROJECT_ROOT/$command"; then
            all_linked=0
            break
        fi
    done
    if [ "$all_linked" = 1 ]; then
        echo "Development links are already active."
        return
    fi

    echo "Unlinking Homebrew formula: $FORMULA"
    "$BREW" unlink "$FORMULA"

    local created=()
    local target source
    for command in "${COMMANDS[@]}"; do
        target="$BIN_DIR/$command"
        source="$PROJECT_ROOT/$command"
        if [ -e "$target" ] || [ -L "$target" ]; then
            echo "Error: Refusing to overwrite existing path: $target" >&2
            rollback_links "${created[@]}"
            exit 1
        fi
        if ! ln -s "$source" "$target"; then
            rollback_links "${created[@]}"
            exit 1
        fi
        created+=("$target")
    done

    echo "Development links installed:"
    for command in "${COMMANDS[@]}"; do
        echo "  $BIN_DIR/$command -> $PROJECT_ROOT/$command"
    done
    echo "Run '$(basename "$0") restore' when testing is complete."
}

rollback_links() {
    local target command source
    for target in "$@"; do
        command=$(basename "$target")
        source="$PROJECT_ROOT/$command"
        if is_project_link "$target" "$source"; then
            unlink "$target"
        fi
    done
    echo "Restoring Homebrew formula after link failure..." >&2
    "$BREW" link "$FORMULA" || true
}

restore_homebrew_links() {
    local command target source
    for command in "${COMMANDS[@]}"; do
        target="$BIN_DIR/$command"
        source="$PROJECT_ROOT/$command"
        if [ -e "$target" ] || [ -L "$target" ]; then
            if ! is_project_link "$target" "$source"; then
                fail "Refusing to remove a path not linked to this checkout: $target"
            fi
        fi
    done

    for command in "${COMMANDS[@]}"; do
        target="$BIN_DIR/$command"
        source="$PROJECT_ROOT/$command"
        if is_project_link "$target" "$source"; then
            unlink "$target"
        fi
    done

    echo "Relinking Homebrew formula: $FORMULA"
    "$BREW" link "$FORMULA"
    echo "Homebrew gitai commands restored."
}

if [ "$#" -ne 1 ]; then
    usage >&2
    exit 1
fi

case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    link | restore)
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac

BREW=$(command -v brew) || fail "Homebrew is not installed or not in PATH"
BREW_PREFIX=$($BREW --prefix)
BIN_DIR="$BREW_PREFIX/bin"
[ -d "$BIN_DIR" ] || fail "Homebrew bin directory does not exist: $BIN_DIR"

case "$1" in
    link)
        link_development_commands
        ;;
    restore)
        restore_homebrew_links
        ;;
esac
